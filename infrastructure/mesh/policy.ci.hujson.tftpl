{
  "_comment": "Decoy Tailscale ACL Policy for CI testing and Molecule validation",
  "groups": {
    "group:admin": [
      "admin@example.test"
    ]
  },
  "tagOwners": ${tag_owners},
  "grants": [
    {"src": ["autogroup:owner"], "dst": ["tag:type-network", "svc:network"], "ip": ["22", "tcp:80", "tcp:443"]},
    {
      "src": [
        "autogroup:owner"
      ],
      "dst": [
        "tag:type-iot"
      ],
      "ip": [
        "tcp:80"
      ]
    }
  ],
  "ssh": [
    {
      "action": "check",
      "src": [
        "autogroup:member"
      ],
      "dst": [
        "autogroup:self"
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ],
      "checkPeriod": "12h"
    }
  ],
  "nodeAttrs": [
    {
      "target": [
        "tag:decoy-client"
      ],
      "attr": [
        "nextdns:000000"
      ]
    }
  ]
}

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Automated dependency management configuration for homelab-infra",

  // Baseline presets
  extends: [
    "config:best-practices",
    ":semanticCommits",
    ":pinDevDependencies",
    ":pinAllExceptPeerDependencies",
    ":enableVulnerabilityAlerts",
    "security:openssf-scorecard",
    ":labels(dependencies)",
  ],

  // Global repository controls
  timezone: "UTC",
  dependencyDashboard: false,
  prConcurrentLimit: 10,
  prHourlyLimit: 2,

  // Lockfile maintenance schedule
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on monday"],
    automerge: false,
  },

  // Ignored paths across all package managers
  // Prevents Renovate from scanning and corrupting mise internal lock sidecars
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/init.t",
    "**/.mise/locks/**",
  ],

  // Native manager toggles
  terraform: {
    enabled: true,
  },
  ansible: {
    enabled: true,
  },
  "github-actions": {
    enabled: true,
  },
  mise: {
    enabled: true,
  },
  pep621: {
    enabled: true,
  },
  pyenv: {
    enabled: false,
  },
  nodenv: {
    enabled: false,
  },

  // Custom regex managers for shell scripts and toolchain pins
  customManagers: [
    {
      customType: "regex",
      description: "Custom dependency version tracking for Bash and Shell scripts via comment annotations",
      managerFilePatterns: ["^scripts/.*\\.sh$"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-.]+?))?\\s+[A-Za-z0-9_]+_VERSION="?(?<currentValue>[^"\\s]+)"?',
      ],
    },
    {
      customType: "regex",
      description: "Track Mise CLI version pins in mise.toml and setup-environment composite action",
      managerFilePatterns: [
        "^mise\\.toml$",
        "^\\.github/actions/setup-environment/action\\.ya?ml$",
      ],
      matchStrings: [
        '(?:min_version = "|version: ")(?<currentValue>[^"]+)"[^\n]*# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-.]+?))?(?:\\s|$)',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
  ],

  // Package rules for ecosystem-specific grouping, conventional commit scopes, and automerge policies
  packageRules: [
    // 1a. Terraform / OpenTofu (stable >= 1.0)
    {
      description: "Group and scope stable Terraform and OpenTofu provider/module updates",
      matchManagers: ["terraform"],
      matchCurrentVersion: "!/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/terraform",
      groupName: "terraform providers and modules",
      groupSlug: "terraform-deps",
    },

    // 1b. Terraform / OpenTofu (0.x initial development)
    {
      description: "Group and scope 0.x Terraform and OpenTofu provider/module updates separately",
      matchManagers: ["terraform"],
      matchCurrentVersion: "/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/terraform",
      groupName: "terraform providers and modules (initial development)",
      groupSlug: "terraform-deps-0x",
      automerge: false,
    },

    // 2a. Ansible & Ansible Galaxy (stable >= 1.0)
    {
      description: "Group and scope stable Ansible Galaxy collection and role updates",
      matchManagers: ["ansible", "ansible-galaxy"],
      matchCurrentVersion: "!/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/ansible",
      groupName: "ansible galaxy roles and collections",
      groupSlug: "ansible-deps",
    },

    // 2b. Ansible & Ansible Galaxy (0.x initial development)
    {
      description: "Group and scope 0.x Ansible Galaxy collection and role updates separately",
      matchManagers: ["ansible", "ansible-galaxy"],
      matchCurrentVersion: "/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/ansible",
      groupName: "ansible galaxy roles and collections (initial development)",
      groupSlug: "ansible-deps-0x",
      automerge: false,
    },

    // 3a. GitHub Actions (stable >= 1.0)
    {
      description: "Group and scope stable GitHub Actions updates",
      matchManagers: ["github-actions"],
      matchCurrentVersion: "!/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/actions",
      groupName: "github actions",
      groupSlug: "github-actions-deps",
    },

    // 3b. GitHub Actions (0.x initial development)
    {
      description: "Group and scope 0.x GitHub Actions updates separately",
      matchManagers: ["github-actions"],
      matchCurrentVersion: "/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/actions",
      groupName: "github actions (initial development)",
      groupSlug: "github-actions-deps-0x",
      automerge: false,
    },

    // 4a. Mise Toolchain (stable >= 1.0)
    {
      description: "Group and scope stable Mise toolchain updates",
      matchManagers: ["mise"],
      matchCurrentVersion: "!/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/mise",
      groupName: "mise toolchain",
      groupSlug: "mise-deps",
    },

    // 4b. Mise Toolchain (0.x initial development)
    {
      description: "Group and scope 0.x Mise toolchain updates separately",
      matchManagers: ["mise"],
      matchCurrentVersion: "/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/mise",
      groupName: "mise toolchain (initial development)",
      groupSlug: "mise-deps-0x",
      automerge: false,
    },

    // 4c. Mise CLI (custom regex manager)
    {
      description: "Group and scope Mise CLI version updates across mise.toml and setup-environment action",
      matchPackageNames: ["jdx/mise"],
      semanticCommitType: "chore",
      semanticCommitScope: "toolchain",
      groupName: "mise cli",
      groupSlug: "mise-cli",
      automerge: false,
    },

    // 5a. Python / UV (stable >= 1.0)
    {
      description: "Group and scope stable Python / UV dependencies",
      matchManagers: ["pep621"],
      matchCurrentVersion: "!/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/python",
      groupName: "python dependencies",
      groupSlug: "python-deps",
    },

    // 5b. Python / UV (0.x initial development)
    {
      description: "Group and scope 0.x Python / UV dependencies separately",
      matchManagers: ["pep621"],
      matchCurrentVersion: "/^0\\./",
      semanticCommitType: "chore",
      semanticCommitScope: "deps/python",
      groupName: "python dependencies (initial development)",
      groupSlug: "python-deps-0x",
      automerge: false,
    },

    // 5c. Python runtime requires-python range strategy
    {
      description: "Ensure PEP 621 requires-python uses bump range strategy to prevent exact patch pinning",
      matchManagers: ["pep621"],
      matchPackageNames: ["python"],
      rangeStrategy: "bump",
    },

    // 5d. Unified Python runtime grouping across mise and pyproject.toml
    {
      description: "Group Python runtime updates across Mise and PEP 621 pyproject.toml",
      matchManagers: ["mise", "pep621"],
      matchPackageNames: ["python"],
      semanticCommitType: "chore",
      semanticCommitScope: "toolchain",
      groupName: "python runtime",
      groupSlug: "python-runtime",
      automerge: false,
    },

    // 6. AI Agent Skills
    {
      description: "Scope AI agent skills updates",
      matchFileNames: ["skills-lock.json"],
      semanticCommitType: "chore",
      semanticCommitScope: "deps/skills",
      automerge: false,
    },

    // 7. Automated Merging (Minor & Patch updates for stable releases)
    {
      description: "Enable platform automerge for safe minor and patch updates on non-0.x versions",
      matchUpdateTypes: ["minor", "patch"],
      matchCurrentVersion: "!/^0\\./",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },

    // 8. Gate 0.x releases (Breaking changes can occur in minor/patch for 0.x)
    {
      description: "Require human review for 0.x versions",
      matchCurrentVersion: "/^0\\./",
      automerge: false,
    },

    // 9. Major Updates (Breaking changes require manual review)
    {
      description: "Require human review for major version upgrades",
      matchUpdateTypes: ["major"],
      automerge: false,
    },

    // 10. Language Runtimes (Python, Node, Go require explicit review)
    {
      description: "Require human review for language runtime upgrades in mise",
      matchManagers: ["mise"],
      matchPackageNames: ["python", "node", "go"],
      automerge: false,
    },
  ],
}

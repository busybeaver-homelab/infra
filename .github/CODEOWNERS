# Code owners: the repository owner reviews changes to security-boundary files.
# Paths that Renovate updates (workflows, actions, renovate.json5, mise.toml,
# mise.lock, uv.lock, pyproject.toml, requirements.yml, *.terraform.lock.hcl)
# are deliberately NOT listed, so dependency updates keep merging automatically
# (owner decision D7, docs/runbooks/ci-workflows-standards.md STD-CI-69).

/.sops.yaml                         @busybeaver
/.sops-recipients.allowlist        @busybeaver
/.gitattributes                     @busybeaver
/secrets/                           @busybeaver
/lefthook.yml                       @busybeaver
# Guard scripts by prefix, so new guards are owned without a CODEOWNERS edit (REV2-X-5).
/scripts/verify-*                   @busybeaver
/scripts/detect-*                   @busybeaver
/scripts/check-*                    @busybeaver
/scripts/block-*                    @busybeaver
/scripts/guard-*                    @busybeaver
/scripts/rotate-state-passphrase.sh @busybeaver
/infrastructure/github/             @busybeaver
/AGENTS.md                          @busybeaver
/.codex/                            @busybeaver
/.claude/                           @busybeaver
/CLAUDE.md                          @busybeaver
/.agents/agents/                    @busybeaver
/.agents/rules/                     @busybeaver
/.agent/AGENTS.md                   @busybeaver
/.agent/tests/                      @busybeaver
/.agent-models.json                 @busybeaver
/LICENSE                            @busybeaver
/SECURITY.md                        @busybeaver
/skills-lock.json                   @busybeaver
/.github/CODEOWNERS                 @busybeaver

# Renovate-managed files inside owned directories: explicitly unowned (later rules win).
/infrastructure/github/**/versions.tf
/infrastructure/github/**/.terraform.lock.hcl

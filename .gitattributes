# .gitattributes
# SOPS diff driver — shows decrypted plaintext in `git diff` locally for CI decoy secrets ONLY.
# Requires: `git config diff.sops.textconv "sops --decrypt"` (run once, see secrets/README.md).
secrets/credentials.ci.sops.yaml diff=sops merge=binary

# Production secrets MUST NOT use sops textconv to avoid leaking plaintext during git diff
secrets/credentials.sops.yaml -diff merge=binary

# Default binary merge for any other potential sops files without textconv diff
*.sops.yaml merge=binary
*.sops.yml  merge=binary
*.sops.json merge=binary

# git-crypt transparent encryption for documentation, designs, and runbooks
docs/** filter=git-crypt diff=git-crypt

# git-crypt transparent encryption for backups and offline configurations
backups/** filter=git-crypt diff=git-crypt
.gitattributes !filter !diff

# Tailscale ACL policy encryption
infrastructure/tailscale/policy.hujson filter=git-crypt diff=git-crypt
infrastructure/tailscale/policy.ci.hujson !filter !diff
infrastructure/tailscale/policy.hujson.tftpl filter=git-crypt diff=git-crypt
infrastructure/tailscale/policy.ci.hujson.tftpl !filter !diff


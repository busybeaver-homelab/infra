[Unit]
Description=Fetch OCI Vault Secrets to In-Memory tmpfs via Instance Principal
Documentation=https://github.com/jmollner/homelab-infra
After=network-online.target
Wants=network-online.target
Before=restic-backup.service docker.service

[Service]
Type=oneshot
RemainAfterExit=true
Environment="SECRETS_DEST_DIR={{ base_ubuntu_server_oci_secrets_dest_dir }}"
{% if base_ubuntu_server_oci_vault_ocid | default('') | length > 0 %}
Environment="OCI_VAULT_ID={{ base_ubuntu_server_oci_vault_ocid }}"
{% endif %}
ExecStart=/usr/local/bin/oci-fetch-secrets.sh
User=root
Group=root

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ base_ubuntu_server_oci_secrets_dest_dir }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target

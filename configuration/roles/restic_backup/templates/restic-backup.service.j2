[Unit]
Description=Encrypted Nightly Restic Backup
After=network-online.target docker.service
Wants=network-online.target
OnFailure=restic-backup-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile={{ restic_backup_config_dir }}/backup.env

# Load in-memory credentials into ephemeral CREDENTIALS_DIRECTORY
LoadCredential=restic_password:{{ restic_backup_password_file_path }}
{% if restic_backup_s3_secret_key | default('') | length > 0 %}
LoadCredential=oci_s3_secret_key:{{ restic_backup_secrets_dir }}/oci_s3_secret_key
{% endif %}
{% if restic_backup_secondary_enabled | bool %}
LoadCredential=restic_secondary_password:{{ restic_backup_secondary_password_file_path }}
{% if restic_backup_secondary_s3_secret_key | default('') | length > 0 %}
LoadCredential=cloudflare_s3_secret_key:{{ restic_backup_secrets_dir }}/cloudflare_s3_secret_key
{% endif %}
{% endif %}
LoadCredential=healthchecks_ping_url:{{ restic_backup_secrets_dir }}/healthchecks_ping_url

ExecStart={{ restic_backup_runner_script_path }}

# --- Process & Security Hardening ---
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service

# Explicit read-write filesystem paths
ReadWritePaths={{ restic_backup_cache_dir }} {{ restic_backup_log_dir }} /tmp
# Read-only filesystem paths
ReadOnlyPaths={% for p in restic_backup_paths %}-{{ p }} {% endfor %}

# Resource Priority
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7

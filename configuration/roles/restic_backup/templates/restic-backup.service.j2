[Unit]
Description=Encrypted Nightly Restic Backup
After=network-online.target docker.service
Wants=network-online.target
OnFailure=restic-backup-failure@%n.service

[Service]
Type=oneshot
# restic retries locks for up to 2h per target; bound the whole run so a hang cannot block later runs
TimeoutStartSec=4h
EnvironmentFile={{ restic_backup_config_dir }}/backup.env

# Secrets: systemd encrypted credentials, decrypted only into this unit's private
# $CREDENTIALS_DIRECTORY at start. They persist across reboots in the credstore.
LoadCredentialEncrypted=restic_password:{{ restic_backup_credstore_dir }}/restic_password
{% if restic_backup_s3_secret_key | default('') | length > 0 %}
LoadCredentialEncrypted=primary_s3_secret_key:{{ restic_backup_credstore_dir }}/primary_s3_secret_key
{% endif %}
{% if restic_backup_secondary_enabled | bool %}
LoadCredentialEncrypted=restic_secondary_password:{{ restic_backup_credstore_dir }}/restic_secondary_password
{% if restic_backup_secondary_s3_secret_key | default('') | length > 0 %}
LoadCredentialEncrypted=cloudflare_s3_secret_key:{{ restic_backup_credstore_dir }}/cloudflare_s3_secret_key
{% endif %}
{% endif %}
{% if restic_backup_healthchecks_ping_url | default('') | length > 0 %}
LoadCredentialEncrypted=healthchecks_ping_url:{{ restic_backup_credstore_dir }}/healthchecks_ping_url
{% endif %}

ExecStart={{ restic_backup_runner_script_path }}

# --- Process & Security Hardening ---
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Root may read (not modify) data owned by other UIDs, e.g. 0700 container volumes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
SystemCallFilter=@system-service

# Explicit read-write filesystem paths
ReadWritePaths={{ restic_backup_cache_dir }} {{ restic_backup_log_dir }} /tmp -/var/backups/containers
# Read-only filesystem paths
ReadOnlyPaths={% for p in restic_backup_paths if p != '/var/backups/containers' %}-{{ p }} {% endfor %}

# Resource Priority
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7

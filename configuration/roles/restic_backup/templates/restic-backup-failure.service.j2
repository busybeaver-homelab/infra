[Unit]
Description=Restic Backup Failure Alert for %I
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
{% if restic_backup_healthchecks_ping_url | default('') | length > 0 %}
LoadCredentialEncrypted=healthchecks_ping_url:{{ restic_backup_credstore_dir }}/healthchecks_ping_url
{% endif %}
ExecStart={{ restic_backup_libexec_dir }}/restic-backup-notify fail %i
TimeoutStartSec=2min
User=root
Group=root

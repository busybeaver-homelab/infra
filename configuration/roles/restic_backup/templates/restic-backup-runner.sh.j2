#!/usr/bin/env bash
# Managed by Ansible - do not edit manually
set -euo pipefail

echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Starting restic backup procedure..."

# Execute post-hooks on exit (even on failure)
run_post_hooks() {
  local exit_code=$?
  if [ -d "{{ restic_backup_config_dir }}/hooks.d/post.d" ] && [ -n "$(ls -A "{{ restic_backup_config_dir }}/hooks.d/post.d" 2>/dev/null)" ]; then
    echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Executing post-backup hooks..."
    run-parts --regex='.*' "{{ restic_backup_config_dir }}/hooks.d/post.d" || true
  fi
  exit "$exit_code"
}
trap run_post_hooks EXIT

# Execute pre-hooks
if [ -d "{{ restic_backup_config_dir }}/hooks.d/pre.d" ] && [ -n "$(ls -A "{{ restic_backup_config_dir }}/hooks.d/pre.d" 2>/dev/null)" ]; then
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Executing pre-backup hooks..."
  run-parts --regex='.*' "{{ restic_backup_config_dir }}/hooks.d/pre.d"
fi

# Initialize repository if not already initialized
echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Checking repository status..."
if ! restic --retry-lock 2h cat config >/dev/null 2>&1; then
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Initializing new restic repository..."
  restic --retry-lock 2h init
fi

# Collect existing paths to backup
BACKUP_PATHS=()
for path in {% for path in restic_backup_paths %}"{{ path }}" {% endfor %}; do
  if [ -e "$path" ]; then
    BACKUP_PATHS+=("$path")
  else
    echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Warning: Backup path $path does not exist, skipping..."
  fi
done

if [ {{ '${#' }}BACKUP_PATHS[@]} -eq 0 ]; then
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Error: No backup paths exist to back up."
  exit 1
fi

# Run backup
echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Running restic backup..."
restic --retry-lock 2h backup \
  --exclude-file="{{ restic_backup_config_dir }}/excludes.txt" \
  --tag "scheduled" \
  "${BACKUP_PATHS[@]}"

# Sync snapshots to secondary DR repository if configured
if [ -n "${RESTIC_SECONDARY_REPOSITORY:-}" ]; then
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Syncing snapshots to secondary DR repository..."
  restic --retry-lock 2h copy --from-repo "$RESTIC_REPOSITORY" --to-repo "$RESTIC_SECONDARY_REPOSITORY"
fi

# Perform integrity check on data subset
echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Running subset integrity check..."
restic --retry-lock 2h check --read-data-subset=1%

# Send heartbeat ping on successful completion
if [ -n "${HEALTHCHECKS_PING_URL:-}" ]; then
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Sending heartbeat ping to Healthchecks.io..."
  curl -fsS -m 10 --retry 3 "${HEALTHCHECKS_PING_URL}"
fi

echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Backup completed successfully."

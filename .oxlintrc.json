{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".ruff_cache/**",
    ".venv/**",
    ".worktrees/**"
  ],
  "env": {
    "browser": false,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "warn",
    "nursery": "off",
    "restriction": "off"
  }
}

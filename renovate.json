{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":labels(dependencies)"
  ],
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automatically merge safe minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Group all development and non-major dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    }
  ],
  "terraform": {
    "enabled": true
  },
  "ansible": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "mise": {
    "enabled": true
  },
  "pep621": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Enable dependency updates for custom variables in Bash/Shell scripts using comments",
      "fileMatch": ["^scripts/.*\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-.]+?))?\\s+[A-Za-z0-9_]+_VERSION=\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}

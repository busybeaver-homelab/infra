{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinDevDependencies",
    "semanticCommits",
    "pinAllExceptPeerDependencies",
    ":enableVulnerabilityAlerts",
    "security:openssf-scorecard",
    ":labels(dependencies)"
  ],
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Automatically merge safe minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ],
  "terraform": {
    "enabled": true
  },
  "ansible": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "mise": {
    "enabled": true
  },
  "pep621": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Enable dependency updates for custom variables in Bash/Shell scripts using comments",
      "managerFilePatterns": ["^scripts/.*\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-.]+?))?\\s+[A-Za-z0-9_]+_VERSION=\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}

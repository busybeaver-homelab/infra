Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

### Terraform & OpenTofu ###
# Local .terraform and .tofu directories
**/.terraform/*
**/.tofu/*

# State and plan files are never committed (STD-OT-22). Remote state lives encrypted in R2;
# a stray local state or saved plan in this public repository would be a full disclosure.
*.tfstate
*.tfstate.*
*.tfplan
.terraform.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars and .tofu.vars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json
*.tofu.vars
*.tofu.vars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json
override.tofu
override.tofu.json
*_override.tofu
*_override.tofu.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan and tofuplan files to ignore the plan output of command: tofu plan -out=tofuplan
*tfplan*
*tofuplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
.tofurc
tofu.rc


### Terragrunt ###
# terragrunt cache directories
**/.terragrunt-cache/*

# Terragrunt debug output file (when using `--terragrunt-debug` option)
# See: https://terragrunt.gruntwork.io/docs/reference/cli-options/#terragrunt-debug
terragrunt-debug.tfvars.json

